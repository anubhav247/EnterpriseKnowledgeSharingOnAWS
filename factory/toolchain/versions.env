# Every check-tool version, pinned. One source of truth for factory/check.sh,
# factory/toolchain/install.sh and .github/workflows/check.yml.
# Plain KEY=value lines only: CI loads them with grep into $GITHUB_ENV.
# Verified against the official release pages on 2026-11-21.
# Bump a tool: change it here (and its sha256), in its own PR.

# Python and its installer. uv also downloads the pinned Python.
PYTHON_VERSION=3.12.16
UV_VERSION=0.13.9
UV_SHA256_linux_arm64=0797542018e541a9288855df555c8077eed06f7a47d206362030480e8ecc9f3d
UV_SHA256_linux_x64=a7fbaff2b9a271d85c1bdb540941090fd1ce011797b4abeb48e4dcd39c2471d5

# Python check tools (PyPI)
RUFF_VERSION=0.17.6
MYPY_VERSION=2.4.1
PYTEST_VERSION=9.2.0
COVERAGE_VERSION=7.17.4
DIFF_COVER_VERSION=11.0.4
HYPOTHESIS_VERSION=6.170.17
SEMGREP_VERSION=1.186.0
PIP_AUDIT_VERSION=2.10.1
CFN_LINT_VERSION=1.61.0
CHECKOV_VERSION=3.4.6

# Secrets scanner (GitHub release, checked by sha256)
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256_linux_arm64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
GITLEAKS_SHA256_linux_x64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# Node 24 LTS (Krypton): the CDK libraries run on it. Not Node 26: its linux
# binary needs libatomic, which stock Amazon Linux 2023 does not have.
NODE_VERSION=24.22.3
NODE_SHA256_linux_arm64=6e51a2ada00f0011cc266f65d98922b403d7ad88f809ca2aa615a5fe1ce6e86c
NODE_SHA256_linux_x64=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
# CDK CLI (npm), for the deploy workflow; check.sh synths without it.
AWS_CDK_CLI_VERSION=2.1149.0
